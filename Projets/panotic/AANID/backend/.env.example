# ─── Serveur ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Neon PostgreSQL (recommandé) ─────────────────────────────
# Créer un projet sur https://neon.tech → copier la connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ─── JWT (auth w-d) — générer avec: openssl rand -hex 32 ─────
AANID_ACCESS_SECRET=change-me-access-secret-min-32-chars
AANID_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Vérifier l'email automatiquement (pas de service mail encore)
AANID_AUTO_VERIFY_EMAIL=true

# ─── Redis (optionnel, gateway) ────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── CORS (production) ───────────────────────────────────────
# CORS_ORIGIN=https://your-app.onrender.com

# ─── KKiaPay (paiement formations & abonnements) ─────────────
# Créer un compte sur https://kkiapay.me → clés d'API (mode sandbox)
# Sans clé privée, le paiement tourne en mode simulation.
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_ENVIRONMENT=sandbox

# ─── SMTP (emails de vérification / réinitialisation) ────────
# Sans SMTP configuré, les tokens sont affichés dans les logs (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AANID <no-reply@aanid.bj>"
APP_BASE_URL=http://localhost:8080

# ─── Connexion sociale OAuth ───────────────────────────────────
# URL publique du backend. Les callbacks à enregistrer chez chaque fournisseur :
# https://aanid-api.onrender.com/api/v1/auth/oauth/google/callback
# https://aanid-api.onrender.com/api/v1/auth/oauth/facebook/callback
# https://aanid-api.onrender.com/api/v1/auth/oauth/x/callback
API_PUBLIC_URL=http://localhost:4000
OAUTH_APP_REDIRECT_URIS=aanid://oauth/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0

X_CLIENT_ID=
X_CLIENT_SECRET=
