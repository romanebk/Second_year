# Supabase — copy this file to .env.local and fill in your project's values
# (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Your production domain — used to build correct absolute URLs for the
# social share image (og:image). Optional locally; on Vercel it falls back
# to the deployment's own URL if unset, but set it to your final custom
# domain once you have one.
NEXT_PUBLIC_SITE_URL=https://votre-domaine.vercel.app

# --- Service d'ingestion Google Trends (optionnel) ------------------------
# Active le bouton « Google Trends » de la page /admin.
# Le service Python vit dans services/trends-ingestion/ et se déploie
# séparément (voir son README). Sans ces variables, le bouton affiche un
# message explicite au lieu d'échouer.
#
# ⚠️ N'ajoutez JAMAIS ici la clé service_role Supabase : elle contourne la
# Row Level Security et doit rester exclusivement côté service Python.
TRENDS_SERVICE_URL=https://votre-service-ingestion.onrender.com
TRENDS_SERVICE_SECRET=

# --- Abonnement : 25 € / mois, deux agrégateurs ---------------------------
# Le même abonnement est vendu par deux canaux, choisis selon le pays :
#   • Paddle  → carte bancaire en euros (Europe et reste du monde)
#   • FedaPay → Mobile Money en francs CFA (Afrique de l'Ouest)
# Chacun fonctionne indépendamment : si un seul est configuré, seul son
# moyen de paiement est proposé.

# --- Paddle (carte bancaire, EUR) -----------------------------------------
# Clé d'API serveur (Paddle → Developer tools → Authentication).
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxxxxxx

# Jeton client, transmis au navigateur pour ouvrir le checkout. Public par
# nature, mais volontairement sans préfixe NEXT_PUBLIC_ : il est passé en
# prop depuis un composant serveur (Paddle → Authentication → Client-side).
PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxx

# Identifiant du prix récurrent mensuel créé dans le catalogue Paddle
# (Catalog → Products → Prices). C'est LUI qui fixe le montant réellement
# débité : il doit valoir 25 € / mois, comme ABONNEMENT_PRIX_EUR.
PADDLE_PRICE_ID=pri_xxxxxxxxxxxx

# Secret du webhook Paddle (Developer tools → Notifications). Sert à vérifier
# l'entête Paddle-Signature. Sans lui, le webhook refuse toutes les requêtes.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxx

# 'production' en production, toute autre valeur (ou absence) = bac à sable.
PADDLE_ENVIRONMENT=sandbox

# --- FedaPay (Mobile Money, XOF) ------------------------------------------
# Clé secrète FedaPay (Dashboard FedaPay → API). Utilisée UNIQUEMENT côté
# serveur pour créer les transactions.
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxx

# 'sandbox' pour les tests, 'live' en production.
# Par sécurité, toute autre valeur (ou absence) équivaut à 'sandbox' :
# un oubli de configuration n'encaissera jamais de vrai argent.
FEDAPAY_ENVIRONMENT=sandbox

# Secret du point de terminaison webhook (Dashboard FedaPay → Webhooks).
# Sert à vérifier la signature X-FEDAPAY-SIGNATURE. Sans lui, le webhook
# refuse toutes les requêtes.
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxxxxxx

# ⚠️ Clé service_role Supabase — contourne la Row Level Security.
# Requise ici car seul le webhook peut activer un abonnement, ce que la RLS
# interdit à l'utilisateur. Ne JAMAIS la préfixer de NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role
