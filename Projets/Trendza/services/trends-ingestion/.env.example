# --- Supabase -------------------------------------------------------------
# ⚠️ La clé service_role contourne la Row Level Security.
# Elle ne doit exister QUE dans l'environnement de ce service.
# Jamais dans l'app Next.js, jamais préfixée NEXT_PUBLIC_, jamais commitée.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# --- Sécurité de l'API ----------------------------------------------------
# Secret partagé avec l'app Next.js (variable TRENDS_SERVICE_SECRET côté Vercel).
# Générer avec : openssl rand -hex 32
TRENDS_SERVICE_SECRET=
