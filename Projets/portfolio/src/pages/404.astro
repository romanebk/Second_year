---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 : Page introuvable" includeSidebar={false}>
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center">
    <h1 class="text-7xl sm:text-8xl md:text-9xl font-heading font-bold gradient-text leading-none">404</h1>
    <p class="text-xl md:text-2xl font-heading font-semibold mt-6">Page introuvable</p>
    <p class="text-base md:text-lg text-base-content/50 font-body mt-3 max-w-md leading-relaxed">
      La page que tu cherches n'existe pas ou a été déplacée.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-10">
      <a href="/" class="btn btn-primary rounded-full px-6 font-heading font-medium">← Retour à l'accueil</a>
      <a href="/projects" class="btn btn-outline rounded-full px-6 font-heading font-medium border-base-content/20 hover:border-[#00f0ff] hover:text-[#00f0ff]">Voir mes projets</a>
    </div>
  </div>
</BaseLayout>
